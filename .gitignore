dist/
node_modules/
.DS_Store
# Halo workspace state (sessions, sqlite, runtime.lock) — present when this repo is opened as a workspace.
# Root only: workspaces/<id>/.halo/ is shared content and must stay tracked.
/.halo/
# draw.io webapp (~60 MB) is regenerated by extensions/drawio/fetch-deps.sh and shipped only in the release zip
extensions/drawio/webapp/
# Excalidraw build output (bundle + fonts), regenerated by extensions/excalidraw/build.sh; shipped only in the release zip
extensions/excalidraw/app/
# EmulatorJS runtime + Genesis Plus GX core (~2 MB), regenerated by extensions/megadrive/fetch-deps.sh; shipped only in the release zip
extensions/megadrive/emulatorjs/
# EmulatorJS runtime + FinalBurn Neo core (~9 MB), regenerated by extensions/arcade/fetch-deps.sh; shipped only in the release zip
extensions/arcade/emulatorjs/
